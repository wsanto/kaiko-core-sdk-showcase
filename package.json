{
  "name": "kaiko",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "node scripts/build-lambdas.js",
    "deploy": "serverless deploy",
    "install:agent": "cd src/agents && bun install",
    "agent": "cd src/agents && bun run dev",
    "test": "bun test",
    "dev": "nodemon --watch \"./src\" --delay 2 --ext \"ts,js\" --exec \"serverless offline --config serverless.local.yml\"",
    "login": "serverless login",
    "lint": "eslint ./src/auth ./src/emotion --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit -p tsconfig.test.json",
    "type-check:all": "npm run type-check && npm run type-check:tests",
    "cdk:bootstrap": "cd infra && cdk bootstrap",
    "cdk:synth": "npm run build && cd infra && cdk synth",
    "cdk:diff": "npm run build && cd infra && cdk diff",
    "cdk:deploy:stg": "npm run build && cd infra && cdk deploy --context stage=stg",
    "cdk:deploy:prod": "npm run build && cd infra && cdk deploy --context stage=prod",
    "cdk:destroy:stg": "cd infra && cdk destroy --context stage=stg",
    "cdk:destroy:prod": "cd infra && cdk destroy --context stage=prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@aws-sdk/client-sqs": "^3.893.0",
    "@elizaos/core": "^1.3.2",
    "@hono/oauth-providers": "^0.8.5",
    "@supabase/supabase-js": "^2.58.0",
    "@vinejs/vine": "^3.0.1",
    "aws-lambda": "^1.0.7",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.8.12",
    "jose": "^6.1.0",
    "nanoid": "^5.1.5",
    "openai": "^5.19.1",
    "pg": "^8.16.3",
    "postgres-range": "^1.1.4",
    "rambda": "^10.3.2",
    "stripe": "^19.1.0",
    "tsyringe": "^4.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/bun": "^1.2.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "core-js": "^3.45.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jiti": "^2.5.1",
    "nodemon": "^3.1.10",
    "reflect-metadata": "^0.2.2",
    "serverless": "^4.21.0",
    "serverless-offline": "^14.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
